# ============================================================
# VEIL — Local Environment Configuration
# This file is for local development only. It is NOT source
# code and must never be committed to version control.
#
# DATABASE_URL uses SQLite for this starter stage. The schema
# is portable: production targets PostgreSQL (see prisma/schema.prisma).
# ============================================================

DATABASE_URL="file:./dev.db"

# Development seed credentials for the BOL-1385 membership record.
# Read by prisma/seed.mjs to derive the argon2 password hash.
# The plaintext value never appears in source code, reports, or logs.
# Rotate/remove before any production deployment.
VEIL_BOL1385_PASSWORD="Dankwah@1385"
